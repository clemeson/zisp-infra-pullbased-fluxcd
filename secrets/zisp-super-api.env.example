# -> GitHub Secret  ZISP_SUPER_API_ENV   (repo zisp-infra)
#
# Sem DATABASE_URL: este serviço usa DynamoDB, não Postgres.
#
# As flags de comportamento (BDR_*, LEADS_*, CORS_ORIGINS, nomes de tabela)
# ficam no ConfigMap de apps/zisp-super-api.yaml. Em especial
# BDR_AUTONOMOUS_ENABLED, que está desligado desde o ban do número em
# 28/09/2026 e cuja razão precisa ficar visível em git, não escondida num
# cofre.

# openssl rand -hex 32, um valor DIFERENTE para cada. Invalida as sessões do
# painel super -- sem custo, não há sessão ativa.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# openssl rand -hex 32
LEADS_INGEST_TOKEN=

# Travam o boot (getOrThrow em três repositórios de contexto).
#
# ATENÇÃO AO NOME: no zisp-api a mesma chave se chama
# SUPER_API_INTERNAL_TOKEN. Nomes diferentes, MESMO valor -- e o erro não
# aparece no boot, aparece quando a primeira chamada entre serviços dá 401.
ZISP_API_INTERNAL_TOKEN=

# Runtime: DynamoDB e SES. ROTAR -- o par antigo passou por chat.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Reemitir no Calendly. São as duas únicas chaves desta lista que dependem de
# terceiro: nenhuma se regenera localmente.
CALENDLY_API_TOKEN=
CALENDLY_WEBHOOK_TOKEN=

# Agente BDR (bdr-agent.service.ts). O SDK resolve ANTHROPIC_API_KEY do
# ambiente sozinho -- não aparece num grep por configService, e foi por isso
# que faltou na primeira versão deste molde.
#
# Verificado em 02/11/2026: `new Anthropic()` sem a chave NÃO lança no
# construtor, então o pod sobe normalmente e a falha aparece na primeira
# chamada à API. Com BDR_AUTONOMOUS_ENABLED desligado (ver ConfigMap), pode
# ficar vazia por ora.
ANTHROPIC_API_KEY=

# Opcional: só é necessário se a key acima for de ORGANIZAÇÃO, não vinculada
# a um Workspace no Console. Nesse caso o header é obrigatório e sem ele toda
# requisição volta 400 "This API key is not scoped to a workspace".
ANTHROPIC_WORKSPACE_ID=
